# E2E Testing Environment - Android Emulator
# Copy this file to .env before running E2E tests on Android

# Local Supabase (Android emulator needs 10.0.2.2 instead of localhost)
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_LOCAL_ANON_KEY_HERE

# Dummy values for OAuth (not used in E2E tests)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=test-ios-client-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=test-web-client-id
