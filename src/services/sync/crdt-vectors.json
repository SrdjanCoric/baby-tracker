      "expected": {
        "fields": { "notes": "hi", "amountMl": 100 },
        "fieldClocks": {
          "notes": "2026-07-04T10:00:00.000Z-0000-device-a",
          "amountMl": "2026-07-04T10:05:00.000Z-0000-device-b"
        }
      }
    },
