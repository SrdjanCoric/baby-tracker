# Baby Tracker Environment Variables
# Copy this file to .env.local and fill in values

# ===========================================
# Supabase Configuration (for future backend)
# ===========================================
# Get these from your Supabase project settings
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# PowerSync Configuration (for offline sync)
# ===========================================
# Get these from your PowerSync dashboard
# POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
