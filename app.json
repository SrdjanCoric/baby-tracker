{
  "expo": {
    "name": "Sofi Baby Tracker",
    "slug": "sofi-baby-tracker",
    "version": "4.9.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "sofibaby",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5A472"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sofibaby.app",
      "usesAppleSignIn": true,
      "associatedDomains": [],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.sofibaby.app"
        ],
        "keychain-access-groups": [
          "743WPPWD3W.com.sofibaby.shared-session"
        ]
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "sofibaby"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.653434931400-nk9pihvpbid2g0sj0g7gqk85bcn9r9ua"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "sr",
          "es",
          "es-ES",
          "fr",
          "pt-PT",
          "pt-BR",
          "de",
          "it"
        ],
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5A472"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.sofibaby.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "sofibaby",
              "host": "login-callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "sofibaby",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/with-16kb-pages",
      "./plugins/with-live-activity-controller",
      "./plugins/with-shared-supabase-session",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F5A472"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.653434931400-nk9pihvpbid2g0sj0g7gqk85bcn9r9ua",
          "googleServicesFile": "./google-services.json"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to add a baby photo."
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "743WPPWD3W"
        }
      ],
      "./plugins/with-watch-complication/index.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b4c35e5f-c130-4dfd-8245-ac4b7fe89628"
      },
      "router": {}
    },
    "owner": "srdjano1"
  }
}
